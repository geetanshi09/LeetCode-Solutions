class Solution {
    public int maxDepth(TreeNode root) {
        if(root==null) return 0;
        int c = 0;
        Queue<TreeNode> q = new LinkedList<>();
        q.add(root);

        while(!q.isEmpty()){
            int s = q.size();
            for(int i=0;i<s;i++){
                TreeNode x = q.poll();
                if(x.left!=null) q.add(x.left);
                if(x.right!=null) q.add(x.right);
            }
            c++;
        }
        return c;
    }
}
